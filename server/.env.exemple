# Porta do Servidor Node.js
PORT=4000

# MongoDB (String de conexao do MongoDB Atlas ou Railway)
DATABASE_URL=mongodb+srv://usuario:senha@cluster0.mongodb.net/chatapp?retryWrites=true&w=majority

# JWT Secrets (Gere textos longos e aleatorios para assinatura de tokens)
JWT_SECRET=chat_app_jwt_secret_super_seguro_2026_key
JWT_REFRESH_SECRET=chat_app_refresh_secret_super_seguro_2026_key

# Envio de Emails Transacionais (Resend - chave comeca com 're_')
RESEND_API_KEY=re_123456789_sua_chave_aqui

# Upload de Imagens e Arquivos (Cloudinary)
CLOUDINARY_URL=cloudinary://123456789:abcdefg@seu_cloud_name

# URL do Frontend Client (Vite React)
CLIENT_URL=http://localhost:5173
NODE_ENV=development